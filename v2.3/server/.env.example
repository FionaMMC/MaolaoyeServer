# === Server 端配置模板 ===
# 实际使用：cp .env.example .env 后按环境填值

# HTTP / 鉴权。legacy QMT_API_KEY 仅用于现有 paper；新部署优先分开两把 key。
QMT_API_KEY=
QMT_PAPER_API_KEY=
QMT_LIVE_API_KEY=
QMT_PAPER_CLIENT_ID=legacy-paper-client
QMT_LIVE_CLIENT_ID=
QMT_PAPER_ACCOUNT_ALIASES_CSV=
QMT_LIVE_ACCOUNT_ALIASES_CSV=
QMT_HOST=0.0.0.0
QMT_PORT=8000

# 所有 live 开关默认关闭。书面验收、私有凭据和双人复核前不得改 true。
QMT_LIVE_ORDER_GENERATION_ENABLED=false
QMT_LIVE_ORDER_DELIVERY_ENABLED=false
QMT_LIVE_CASH_FLOW_INGEST_ENABLED=false
QMT_LIVE_ACCOUNT_INITIALIZATION_ENABLED=false
QMT_LIVE_QMT_ACCOUNT_SHA256=

# Hydra allowlist 与 publisher；publisher 必须是批准的 full Git SHA。
QMT_HYDRA_ALLOWED_SYMBOLS_CSV=510300.SH,159915.SZ,511260.SH,518880.SH,159981.SZ,159985.SZ,159930.SZ,513500.SH,513100.SH
QMT_HYDRA_ALLOWED_PUBLISHER_COMMITS_CSV=

# 0 表示未批准，live relay 会 fail-closed。
QMT_LIVE_MAX_DAILY_ORDERS=0
QMT_LIVE_MAX_SINGLE_ORDER_NOTIONAL=0
QMT_LIVE_MAX_DAILY_BUY_NOTIONAL=0
QMT_LIVE_MAX_DAILY_SELL_NOTIONAL=0
QMT_LIVE_MAX_DAILY_TURNOVER_NOTIONAL=0
QMT_LIVE_MAX_PRICE_OFFSET_BPS=0

# 业务数据
QMT_DB_URL=sqlite:///./pipeline-server.db
QMT_PARQUET_ROOT=./data

# 策略
QMT_PLUGINS_DIR=./plugins
QMT_STRATEGIES_FILE=strategies.yaml

# 日志
QMT_LOG_LEVEL=INFO
QMT_LOG_JSON=false   # true=JSON，部署时打开
