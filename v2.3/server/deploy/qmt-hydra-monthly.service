[Unit]
Description=Hydra server monthly research to execution plan (never broker submit)
After=qmt-server.service

[Service]
Type=oneshot
User=qmtserver
WorkingDirectory=/opt/qmt-server/v2.3/server
EnvironmentFile=/opt/qmt-server/v2.3/server/.env
Environment=PYTHONPATH=.
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/qmt-server/venv/bin/python scripts/run_hydra_monthly.py --apply
TimeoutStartSec=12min
Nice=10
MemoryMax=2G
NoNewPrivileges=true
