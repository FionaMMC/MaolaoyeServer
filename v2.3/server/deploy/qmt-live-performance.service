[Unit]
Description=Hydra live ledger EOD valuation (no order generation)
After=qmt-server.service

[Service]
Type=oneshot
User=qmtserver
Group=qmtserver
WorkingDirectory=/opt/qmt-server/v2.3/server
EnvironmentFile=/opt/qmt-server/v2.3/server/.env
ExecStart=/opt/qmt-server/venv/bin/python -m scripts.run_live_performance --backfill
TimeoutStartSec=5min
