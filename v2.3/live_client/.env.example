# Copy to a private environment; never commit the filled file.
HYDRA_LIVE_MODE=mock_qmt
HYDRA_LIVE_EXECUTION_DOMAIN=live
HYDRA_LIVE_QMT_ACCOUNT_ID=
HYDRA_LIVE_EXPECTED_ACCOUNT_SHA256=
HYDRA_LIVE_ACCOUNT_ALIAS=hydra-live
HYDRA_LIVE_INSTANCE_ID=live_hydra_v481_rb
HYDRA_LIVE_LEDGER_MODE=attributed
# 仅首次初始化使用；运行中的可用权益由 Server 子账本随盈亏/费用/分红滚动。
HYDRA_LIVE_INITIAL_ALLOCATED_CASH=211000
HYDRA_LIVE_INITIAL_ALLOCATED_POSITIONS_JSON={}
HYDRA_LIVE_API_KEY=
# Current deployment may explicitly use http://120.26.138.82:8000 together with
# HYDRA_LIVE_ALLOW_INSECURE_HTTP=true.  Keep the generic template fail-closed.
HYDRA_LIVE_SERVER_BASE_URL=https://qmt.example.invalid
HYDRA_LIVE_QMT_USERDATA_DIR=C:\private\hydra-live\userdata_mini
HYDRA_LIVE_QMT_SESSION_ID=0
HYDRA_LIVE_STATE_DB=C:\private\hydra-live\state\hydra-live.db
HYDRA_LIVE_LOG_DIR=C:\private\hydra-live\logs
HYDRA_LIVE_TASK_PREFIX=HydraLive
HYDRA_LIVE_TRADING_ENABLED=false
# Independent one-lot real-MiniQMT canary gate.  Keep false except for the
# seconds between approving an immutable canary plan and invoking `canary submit`.
HYDRA_LIVE_CANARY_ENABLED=false
# The owner accepted HTTP for the current server path on 2026-08-29.  Set true
# only in that private Windows live configuration; this template stays false.
HYDRA_LIVE_ALLOW_INSECURE_HTTP=false
HYDRA_LIVE_ALLOWED_SYMBOLS=510300.SH,159915.SZ,511260.SH,518880.SH,159981.SZ,159985.SZ,159930.SZ,513500.SH,513100.SH
# disabled（默认）完全拒绝批次；static 使用固定金额上限；auto 按 Hydra
# attributed 子账本权益、可用现金和可卖持仓动态计算限额，不使用账户闲置资金。
HYDRA_LIVE_RISK_MODE=disabled
HYDRA_LIVE_MAX_DAILY_ORDERS=0
HYDRA_LIVE_MAX_SINGLE_ORDER_NOTIONAL=0
HYDRA_LIVE_MAX_DAILY_BUY_NOTIONAL=0
HYDRA_LIVE_MAX_DAILY_SELL_NOTIONAL=0
HYDRA_LIVE_MAX_DAILY_TURNOVER_NOTIONAL=0
HYDRA_LIVE_MAX_PRICE_OFFSET_BPS=0
HYDRA_LIVE_AUTO_MAX_DAILY_ORDERS=100
HYDRA_LIVE_AUTO_BUFFER_BPS=100
# Hash from the approved target's execution_raw input. Required only when a
# server-confirmed RESIDUAL is staged for the next trading day.
HYDRA_LIVE_RETRY_EXECUTION_RAW_SHA256=
HYDRA_LIVE_PYTHON=C:\private\miniqmt-python\python.exe
HYDRA_LIVE_CODE_DIR=C:\src\MaolaoyeServer\v2.3
HYDRA_LIVE_CODE_COMMIT=

# Explicit paper denylist/isolation evidence (private values).
HYDRA_PAPER_QMT_ACCOUNT_IDS=
HYDRA_PAPER_QMT_SESSION_IDS=
HYDRA_PAPER_WRITABLE_PATHS=
HYDRA_PAPER_TASK_PREFIXES=
